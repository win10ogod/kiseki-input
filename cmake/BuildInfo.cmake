# Writes the build provenance header. Runs at every build (cmake -P) and only
# touches the output when the commit or dirty state changed, so unchanged trees
# do not recompile. Without git or outside a checkout the commit is "unknown".
#
# Inputs: KISEKI_SOURCE_DIR, KISEKI_BUILD_INFO_OUTPUT, optional GIT_EXECUTABLE,
# optional KISEKI_BUILD_COMMIT (used when the source is not a git checkout,
# e.g. an exported source archive; its dirty state is then reported unknown).

set(commit "unknown")
set(dirty 0)
set(found_checkout FALSE)

if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    # An empty prefix means the source directory is the checkout root, not an
    # unrelated parent repository that happens to contain an extracted tree.
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --show-prefix
        WORKING_DIRECTORY "${KISEKI_SOURCE_DIR}"
        RESULT_VARIABLE prefix_result
        OUTPUT_VARIABLE prefix_output
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(prefix_result EQUAL 0 AND prefix_output STREQUAL "")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" rev-parse --short=12 HEAD
            WORKING_DIRECTORY "${KISEKI_SOURCE_DIR}"
            RESULT_VARIABLE rev_result
            OUTPUT_VARIABLE rev_output
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
    else()
        set(rev_result 1)
    endif()
    if(rev_result EQUAL 0 AND rev_output MATCHES "^[0-9a-f]+$")
        set(found_checkout TRUE)
        set(commit "${rev_output}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${KISEKI_SOURCE_DIR}"
            RESULT_VARIABLE status_result
            OUTPUT_VARIABLE status_output
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT status_result EQUAL 0)
            set(dirty 2)
        elseif(NOT status_output STREQUAL "")
            set(dirty 1)
        endif()
    endif()
endif()

if(NOT found_checkout AND KISEKI_BUILD_COMMIT MATCHES "^[0-9a-fA-F]+$")
    string(TOLOWER "${KISEKI_BUILD_COMMIT}" commit)
    string(LENGTH "${commit}" commit_length)
    if(commit_length GREATER 12)
        string(SUBSTRING "${commit}" 0 12 commit)
    endif()
    set(dirty 2)
endif()

set(content "// Generated by cmake/BuildInfo.cmake; do not edit.
#pragma once
#define KISEKI_BUILD_COMMIT \"${commit}\"
// 0 = clean, 1 = tracked changes, 2 = status unavailable
#define KISEKI_BUILD_DIRTY ${dirty}
")

set(existing "")
if(EXISTS "${KISEKI_BUILD_INFO_OUTPUT}")
    file(READ "${KISEKI_BUILD_INFO_OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${KISEKI_BUILD_INFO_OUTPUT}" "${content}")
endif()
